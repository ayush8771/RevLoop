# RevLoop — environment configuration
# Copy to .env and fill in. NEVER commit .env.

# Razorpay TEST MODE credentials (dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret you configure in the Razorpay webhook settings
RAZORPAY_WEBHOOK_SECRET=

# Groq API key for LLM message drafting (optional; template fallback works without it)
GROQ_API_KEY=

# true  = run fully credential-free with mock Payment Links + mock webhook demo
# false = call the real Razorpay Payment Link API (test-mode keys required)
MOCK_MODE=true

# --- optional ---
# Enable JWT auth on the API (requires admin credentials below)
REVLOOP_AUTH_ENABLED=false
REVLOOP_ADMIN_USERNAME=admin
REVLOOP_ADMIN_PASSWORD=
# Stable JWT signing secret (ephemeral random secret is generated if unset)
REVLOOP_JWT_SECRET=
